PYTHON_IMAGE=python:3.13.14-slim-trixie
MESHTASTIC_WEB_PORT=8766
LONGFAST_CHANNEL_INDEX=0
WEB_USER=admin
WEB_PASSWORD=replace-with-a-long-random-password
# Example location. Change these values for your city.
WEATHER_LOCATION=Москва
WEATHER_LAT=55.7558
WEATHER_LON=37.6173
LOCAL_TIMEZONE=Europe/Moscow
# Optional: chosen BLE node is normally saved from the web UI in SQLite.
# MESHTASTIC_BLE_DEVICE=AA:BB:CC:DD:EE:FF
# Optional: set once to the device's stable identity (not /dev/ttyUSB0).
# The regular compose.yaml passes this port into the container automatically.
# USB_DEVICE=/dev/serial/by-id/usb-Heltec_...
